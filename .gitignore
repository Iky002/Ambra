# Web dependencies & build output (keep .gitkeep so go:embed compiles on fresh clone)
/web/node_modules/
/web/dist/*
!/web/dist/.gitkeep
/web/dist-demo/
/web/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment & secrets
.env
.env.*
!.env.example

# OS & IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
